# Copy to .env.local and fill in. The README has the full table.
# Required: POSTGRES_URL, OPENAI_API_KEY, AUTH_SECRET, ADMIN_PASSWORD_HASH, PSEUDONYM_SALT.

# Pooled Neon or Vercel Postgres connection string (the host contains "-pooler").
# From the Neon console, or `vercel env pull .env.local` for a Vercel project.
POSTGRES_URL=

# OpenAI key. Embeds every brief, and generates text when LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-...

# Signs the instructor session (Auth.js). Generate with: openssl rand -hex 32
AUTH_SECRET=

# bcrypt hash of the instructor password, with each $ escaped as \$.
# Generate with: pnpm change-admin-password --local   (paste the line it prints)
ADMIN_PASSWORD_HASH=

# Salt for the one-way hash that counts student devices. Generate with: openssl rand -hex 32
PSEUDONYM_SALT=replace-with-32-bytes-of-randomness

# Username typed at sign-in. Optional, default "admin".
ADMIN_EMAIL=admin

# Public origin of a deployment, read by Auth.js. Optional. Leave unset for `pnpm dev` and on Vercel.
# AUTH_URL=https://your-host.example

# Generation provider: "openai" (default) or "anthropic". Optional.
LLM_PROVIDER=openai

# Generation key for Anthropic. Needed only when LLM_PROVIDER=anthropic; OPENAI_API_KEY is still needed for embeddings.
ANTHROPIC_API_KEY=

# Generation model id. Optional; default gpt-4o-mini (OpenAI) or claude-haiku-4-5-20251001 (Anthropic).
LLM_GENERATION_MODEL=

# "embedding" (default) retrieves notes; "prompt-pack" switches retrieval off. Optional.
RETRIEVAL_PROVIDER=embedding

# Embedding model. Optional. Changing it means re-running `pnpm embed-corpus`; the code assumes 1536 dimensions.
EMBEDDING_MODEL=text-embedding-3-small

# Most notes given to the model. Optional, default 5.
RETRIEVAL_TOP_K=5

# Lowest cosine score at which a note is eligible. Optional, default 0.25.
RETRIEVAL_MIN_SCORE=0.25

# Public demo (/demo and /api/demo/*). All optional. Limits are in memory per instance; the provider's monthly budget is the real ceiling.
# "0" or "false" pauses the public demo (its routes answer 503). Default: on.
PUBLIC_DEMO=1
# Demo units one visitor may spend in 10 minutes (a generation, a section regeneration or a personalisation is 2, a hint or feedback is 1). 0 disables. Default 24.
DEMO_UNITS_PER_CLIENT_PER_10MIN=24
# Demo units all visitors together may spend per hour, per instance. 0 disables. Default 240.
DEMO_UNITS_GLOBAL_PER_HOUR=240
# Demo units all visitors together may spend per UTC day, per instance. 0 disables. Default 1500.
DEMO_UNITS_PER_DAY=1500

# Read only by scripts. All optional.
# pnpm smoke-check and node scripts/figure2.mjs: instance, sign-in and case.
# BASE_URL=http://localhost:3000
# SIGNIN_USER=admin
# SIGNIN_PASS=
# CASE_ID=seed-case-finance
